<Window x:Class="TagleLabsGestorSST.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TagleLabsGestorSST.UI"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:TagleLabsGestorSST.UI.ViewModels"
        xmlns:views="clr-namespace:TagleLabsGestorSST.UI.Views"
        mc:Ignorable="d"
        Title="Tagle Labs Gestor SST &amp; Cumplimiento" Height="720" Width="1200"
        Background="{StaticResource BrushFondo}"
        FontFamily="{StaticResource FontTexto}">

    <Window.Resources>
        <!-- DataTemplates para mapear ViewModels a Views -->
        <DataTemplate DataType="{x:Type vm:LoginViewModel}">
            <views:LoginView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EmpresasViewModel}">
            <views:EmpresasView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TrabajadoresViewModel}">
            <views:TrabajadoresView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MatrizRiesgosViewModel}">
            <views:MatrizRiesgosView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ObligacionesViewModel}">
            <views:ObligacionesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SiniestrosViewModel}">
            <views:SiniestrosView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DocumentosViewModel}">
            <views:DocumentosView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProcedimientosViewModel}">
            <views:ProcedimientosView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ImportacionViewModel}">
            <views:ImportacionView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AuditoriaViewModel}">
            <views:AuditoriaView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ActualizacionDocumentosViewModel}">
            <views:ActualizacionDocumentosView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BusquedaSemanticaViewModel}">
            <views:BusquedaSemanticaView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AsistenciaViewModel}">
            <views:AsistenciaView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LugarTrabajoViewModel}">
            <views:LugarTrabajoView/>
        </DataTemplate>
    </Window.Resources>

    <materialDesign:DialogHost Identifier="RootDialog" CloseOnClickAway="True">
        <Grid Background="{StaticResource BrushFondo}">
            <!-- Snackbar para notificaciones Toast -->
            <materialDesign:Snackbar x:Name="MainSnackbar" 
                                     MessageQueue="{Binding SnackbarMessageQueue}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Bottom"
                                     Margin="0,0,0,20"/>
            
            <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource BrushPrimario}" 
                Visibility="{Binding IsSidebarVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo -->
                <StackPanel Grid.Row="0" Margin="0,30,0,20">
                    <Path Data="{StaticResource LogoHexagono}" Fill="{StaticResource BrushSecundario}" Height="40" Stretch="Uniform" HorizontalAlignment="Center">
                        <Path.Effect>
                            <DropShadowEffect Color="{StaticResource SecundarioVerde}" BlurRadius="15" ShadowDepth="0" Opacity="0.4"/>
                        </Path.Effect>
                    </Path>
                    <TextBlock Text="TAGLE LABS" Foreground="White" HorizontalAlignment="Center" Margin="0,10,0,0" FontFamily="{StaticResource FontTitulos}" FontSize="16"/>
                    <TextBlock Text="GESTOR SST" Foreground="#94A3B8" HorizontalAlignment="Center" FontSize="10" Opacity="0.8"/>
                </StackPanel>

                <!-- Menú Scrollable -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,10">
                        <TextBlock Text="PRINCIPAL" Foreground="#64748B" FontSize="11" FontWeight="Bold" Margin="25,10,0,5"/>
                        
                        <Button Command="{Binding NavigateToDashboardCommand}" Style="{StaticResource EstiloBotonMenu}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ViewDashboard" Style="{StaticResource PackIconMedium}" Margin="0,0,15,0"/>
                                <TextBlock Text="Dashboard"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateToEmpresasCommand}" Style="{StaticResource EstiloBotonMenu}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Domain" Style="{StaticResource PackIconMedium}" Margin="0,0,15,0"/>
                                <TextBlock Text="Empresas"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateToTrabajadoresCommand}" Style="{StaticResource EstiloBotonMenu}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AccountHardHat" Style="{StaticResource PackIconMedium}" Margin="0,0,15,0"/>
                                <TextBlock Text="Trabajadores"/>
                            </StackPanel>
                        </Button>

                        <TextBlock Text="GESTIÓN RIESGOS" Foreground="#64748B" FontSize="11" FontWeight="Bold" Margin="25,20,0,5"/>

                        <Button Command="{Binding NavigateToMatrizCommand}" Style="{StaticResource EstiloBotonMenu}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AlertOctagon" Style="{StaticResource PackIconMedium}" Margin="0,0,15,0"/>
                                <TextBlock Text="Matriz MIPER"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateToObligacionesCommand}" Style="{StaticResource EstiloBotonMenu}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Gavel" Style="{StaticResource PackIconMedium}" Margin="0,0,15,0"/>
                                <TextBlock Text="Obligaciones"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateToSiniestrosCommand}" Style="{StaticResource EstiloBotonMenu}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="MedicalBag" Style="{StaticResource PackIconMedium}" Margin="0,0,15,0"/>
                                <TextBlock Text="Siniestros"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateToDocumentosCommand}" Style="{StaticResource EstiloBotonMenu}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileDocument" Style="{StaticResource PackIconMedium}" Margin="0,0,15,0"/>
                                <TextBlock Text="Documentos"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateToProcedimientosCommand}" Style="{StaticResource EstiloBotonMenu}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ClipboardText" Style="{StaticResource PackIconMedium}" Margin="0,0,15,0"/>
                                <TextBlock Text="Procedimientos"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateToActualizacionCommand}" Style="{StaticResource EstiloBotonMenu}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Robot" Style="{StaticResource PackIconMedium}" Margin="0,0,15,0"/>
                                <TextBlock Text="Análisis IA"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateToBusquedaSemanticaCommand}" Style="{StaticResource EstiloBotonMenu}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="TextSearch" Style="{StaticResource PackIconMedium}" Margin="0,0,15,0"/>
                                <TextBlock Text="Búsqueda IA"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateToAsistenciaCommand}" Style="{StaticResource EstiloBotonMenu}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ClockCheck" Style="{StaticResource PackIconMedium}" Margin="0,0,15,0"/>
                                <TextBlock Text="Asistencia"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateToLugaresTrabajoCommand}" Style="{StaticResource EstiloBotonMenu}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="MapMarkerMultiple" Style="{StaticResource PackIconMedium}" Margin="0,0,15,0"/>
                                <TextBlock Text="Lugares Trabajo"/>
                            </StackPanel>
                        </Button>

                        <TextBlock Text="SISTEMA" Foreground="#64748B" FontSize="11" FontWeight="Bold" Margin="25,20,0,5"/>

                        <Button Command="{Binding NavigateToImportacionCommand}" Style="{StaticResource EstiloBotonMenu}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="DatabaseImport" Style="{StaticResource PackIconMedium}" Margin="0,0,15,0"/>
                                <TextBlock Text="Importación"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateToAuditoriaCommand}" Style="{StaticResource EstiloBotonMenu}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="History" Style="{StaticResource PackIconMedium}" Margin="0,0,15,0"/>
                                <TextBlock Text="Auditoría"/>
                            </StackPanel>
                        </Button>

                        <!-- NUEVO: Botones de Backup -->
                        <TextBlock Text="DATOS" Foreground="#64748B" FontSize="11" FontWeight="Bold" Margin="25,20,0,5"/>
                        
                        <Button Command="{Binding CrearBackupCommand}" Style="{StaticResource EstiloBotonMenu}" ToolTip="Crear copia de seguridad de la base de datos">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="DatabaseExport" Style="{StaticResource PackIconMedium}" Margin="0,0,15,0"/>
                                <TextBlock Text="Crear Backup"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding RestaurarBackupCommand}" Style="{StaticResource EstiloBotonMenu}" ToolTip="Restaurar base de datos desde backup">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="DatabaseRefresh" Style="{StaticResource PackIconMedium}" Margin="0,0,15,0"/>
                                <TextBlock Text="Restaurar Backup"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer Usuario -->
                <Border Grid.Row="2" Background="#0B1120" Padding="15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <materialDesign:PackIcon Kind="AccountCircle" Foreground="White" Style="{StaticResource PackIconAvatar}"/>
                        
                        <StackPanel Grid.Column="1" Margin="10,0">
                            <TextBlock Text="{Binding UsuarioActualNombre}" Foreground="White" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="Conectado" Foreground="{StaticResource BrushSecundario}" FontSize="11"/>
                        </StackPanel>

                        <Button Grid.Column="2" Command="{Binding CerrarSesionCommand}" Style="{StaticResource MaterialDesignIconForegroundButton}" ToolTip="Cerrar Sesión" Foreground="#EF4444">
                            <materialDesign:PackIcon Kind="Logout" Style="{StaticResource PackIconMedium}"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Área Principal -->
        <Grid Grid.Column="1">
            <!-- Contenido Dinámico (Full Bleed) -->
            <ContentControl Content="{Binding CurrentView}" Margin="0" />
        </Grid>
        </Grid>
        </Grid>
    </materialDesign:DialogHost>
</Window>

