
<UserControl x:Class="TagleLabsGestorSST.UI.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:TagleLabsGestorSST.UI.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*"/> <!-- Branding Area -->
            <ColumnDefinition Width="*"/>   <!-- Login Form -->
        </Grid.ColumnDefinitions>

        <!-- LEFT COLUMN: BRANDING -->
        <Border Grid.Column="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0F172A" Offset="0.0"/> <!-- Slate 900 -->
                    <GradientStop Color="#1E293B" Offset="1.0"/> <!-- Slate 800 -->
                </LinearGradientBrush>
            </Border.Background>
            
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- Logo PNG con Animación de Pulso -->
                <Grid HorizontalAlignment="Center" Margin="0,0,0,30">
                    <!-- Glow Effect Animado -->
                    <Ellipse Width="140" Height="140" Fill="#10B981" Opacity="0.2">
                        <Ellipse.Effect>
                            <BlurEffect Radius="40"/>
                        </Ellipse.Effect>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetProperty="Width" From="130" To="160" Duration="0:0:2"/>
                                        <DoubleAnimation Storyboard.TargetProperty="Height" From="130" To="160" Duration="0:0:2"/>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.15" To="0.3" Duration="0:0:2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    
                    <!-- Icono PNG con máscara para ocultar esquinas -->
                    <Border Width="90" Height="90" CornerRadius="18"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border.Background>
                            <ImageBrush ImageSource="pack://application:,,,/Assets/icon.png" Stretch="UniformToFill"/>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect Color="#10B981" BlurRadius="20" ShadowDepth="0" Opacity="0.7"/>
                        </Border.Effect>
                    </Border>
                </Grid>

                <TextBlock Text="TAGLE LABS" FontSize="42" FontWeight="Bold" Foreground="White" 
                           HorizontalAlignment="Center" FontFamily="{StaticResource FontTitulos}"/>
                
                <TextBlock Text="Gestión Inteligente SST" FontSize="18" Foreground="#64748B" 
                           HorizontalAlignment="Center" Margin="0,10,0,40"/>

                <!-- Feature List con íconos mejorados -->
                <StackPanel Margin="0,20,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <Border Background="#10B981" CornerRadius="20" Padding="6" Margin="0,0,12,0">
                            <materialDesign:PackIcon Kind="Check" Foreground="White" Width="14" Height="14"/>
                        </Border>
                        <TextBlock Text="Cumplimiento Normativo DS44" Foreground="#CBD5E1" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <Border Background="#10B981" CornerRadius="20" Padding="6" Margin="0,0,12,0">
                            <materialDesign:PackIcon Kind="Check" Foreground="White" Width="14" Height="14"/>
                        </Border>
                        <TextBlock Text="Gestión Documental con IA" Foreground="#CBD5E1" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <Border Background="#10B981" CornerRadius="20" Padding="6" Margin="0,0,12,0">
                            <materialDesign:PackIcon Kind="Check" Foreground="White" Width="14" Height="14"/>
                        </Border>
                        <TextBlock Text="Control de Riesgos (MIPER)" Foreground="#CBD5E1" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#6366F1" CornerRadius="20" Padding="6" Margin="0,0,12,0">
                            <materialDesign:PackIcon Kind="Sparkles" Foreground="White" Width="14" Height="14"/>
                        </Border>
                        <TextBlock Text="Búsqueda Semántica IA" Foreground="#A5B4FC" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- RIGHT COLUMN: LOGIN FORM -->
        <Border Grid.Column="1" Background="White">
            <Grid>
                <StackPanel VerticalAlignment="Center" Margin="60,0">
                    <TextBlock Text="Bienvenido" FontSize="32" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,10"/>
                    <TextBlock Text="Ingresa tus credenciales para continuar" FontSize="16" Foreground="#64748B" Margin="0,0,0,40"/>

                    <TextBox materialDesign:HintAssist.Hint="Usuario" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,20" FontSize="14" Height="50" Padding="10,12"
                             materialDesign:HintAssist.Foreground="#64748B" BorderBrush="#E2E8F0"/>

                    <PasswordBox materialDesign:HintAssist.Hint="Contraseña" Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                                 Margin="0,0,0,20" FontSize="14" Height="50" Padding="10,12"
                                 x:Name="PasswordBox"
                                 materialDesign:HintAssist.Foreground="#64748B" BorderBrush="#E2E8F0"/>

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#EF4444" TextWrapping="Wrap" 
                               Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"
                               Margin="0,0,0,20" HorizontalAlignment="Center" FontWeight="SemiBold"/>

                    <Button Command="{Binding LoginCommand}" Content="INICIAR SESIÓN" 
                            Background="#0F172A" BorderBrush="#0F172A" Foreground="White"
                            Height="50" FontSize="14" FontWeight="Bold" materialDesign:ButtonAssist.CornerRadius="8"
                            Cursor="Hand">
                        <Button.Effect>
                            <DropShadowEffect Color="#0F172A" BlurRadius="10" ShadowDepth="3" Opacity="0.2"/>
                        </Button.Effect>
                    </Button>

                    <TextBlock Text="Versión 2.0.0 - Build 2025.11" HorizontalAlignment="Center" Margin="0,40,0,0" Foreground="#CBD5E1" FontSize="12"/>
                </StackPanel>
                
                <!-- Demo Credentials Hint (Bottom Right) -->
                <TextBlock Text="Demo: admin / admin" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="20" Foreground="#E2E8F0" FontSize="10"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
