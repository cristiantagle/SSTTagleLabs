<Window x:Class="TagleLabsGestorSST.UI.Views.VacacionesSolicitudDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Solicitud de Vacaciones"
        Width="500"
        Height="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="White">
    
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Solicitud de Vacaciones" FontSize="20" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,5"/>
            <TextBlock Text="Complete los datos para generar la solicitud" FontSize="12" Foreground="#64748B"/>
        </StackPanel>

        <!-- Información del Trabajador -->
        <Border Grid.Row="1" Background="#F1F5F9" CornerRadius="8" Padding="15" Margin="0,20,0,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <TextBlock Text="Trabajador:" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Grid.Row="1" Text="{Binding Trabajador.NombreCompleto}" FontSize="14" Foreground="#0F172A" Margin="0,5,0,0"/>
                <TextBlock Grid.Row="2" Text="{Binding Trabajador.Rut, StringFormat='RUT: {0}'}" FontSize="12" Foreground="#64748B" Margin="0,3,0,0"/>
            </Grid>
        </Border>

        <!-- Formulario -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Sección: Saldo Actual -->
                <TextBlock Text="Saldo de Vacaciones" FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12"/>
                
                <Border Background="#ECFDF5" BorderBrush="#10B981" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <StackPanel>
                            <TextBlock Text="Días Acumulados" FontSize="11" Foreground="#059669" FontWeight="Bold"/>
                            <TextBlock Text="{Binding DiasAcumulados, StringFormat='0.00'}" FontSize="18" FontWeight="Bold" Foreground="#059669"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Row="1">
                            <TextBlock Text="Días Usados" FontSize="11" Foreground="#059669" FontWeight="Bold" Margin="0,10,0,0"/>
                            <TextBox Text="{Binding DiasUsadosPrevios, UpdateSourceTrigger=PropertyChanged}" 
                                    Height="35"
                                    Margin="0,5,0,0" Padding="10"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2">
                            <TextBlock Text="Saldo Disponible" FontSize="11" Foreground="#059669" FontWeight="Bold" Margin="0,10,0,0"/>
                            <TextBlock Text="{Binding SaldoDisponible, StringFormat='0.00 días'}" FontSize="16" FontWeight="Bold" Foreground="#059669" Margin="0,5,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Días a Solicitar" FontSize="11" Foreground="#059669" FontWeight="Bold"/>
                            <TextBox Text="{Binding DiasASolicitar, UpdateSourceTrigger=PropertyChanged}"
                                    Height="35"
                                    Margin="0,5,0,0" Padding="10"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Sección: Fechas -->
                <TextBlock Text="Período de Vacaciones" FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12"/>
                
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel>
                        <TextBlock Text="Fecha Inicio" FontSize="12" Foreground="#64748B" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <DatePicker SelectedDate="{Binding FechaInicio, UpdateSourceTrigger=PropertyChanged}"
                                   Height="40" Padding="10"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Fecha Término" FontSize="12" Foreground="#64748B" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <DatePicker SelectedDate="{Binding FechaFin, UpdateSourceTrigger=PropertyChanged}"
                                   Height="40" Padding="10"/>
                    </StackPanel>
                </Grid>

                <!-- Nota -->
                <TextBlock Text="⚠️ Verifica el saldo disponible antes de generar la solicitud" 
                          FontSize="11" Foreground="#EF4444" TextWrapping="Wrap" Margin="0,0,0,20"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Botones -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>
            
            <Button Grid.Column="1" Content="Cancelar" Click="CancelarClick" 
                   Style="{StaticResource MaterialDesignOutlinedButton}"/>
            <Button Grid.Column="3" Content="Generar" Command="{Binding GenerarCommand}"
                   Background="#10B981" Foreground="White" FontWeight="Bold"
                   Style="{StaticResource MaterialDesignRaisedButton}"/>
        </Grid>
    </Grid>
</Window>
