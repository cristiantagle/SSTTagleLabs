<UserControl x:Class="TagleLabsGestorSST.UI.Views.ObligacionesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200">
    <Grid Background="#F1F5F9">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER GRADIENTE -->
        <Border Style="{StaticResource EstiloHeaderHero}" Grid.RowSpan="2"/>

        <!-- CONTENIDO -->
        <Grid Grid.Row="1" Margin="30,-80,30,30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <!-- COLUMNA IZQUIERDA: LISTA -->
            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                <TextBlock Text="Obligaciones Normativas" Style="{StaticResource EstiloTituloPagina}" Margin="0,0,0,5"/>
                <TextBlock Text="Seguimiento de cumplimiento legal (DS44, Ley Karin)" Style="{StaticResource EstiloSubtituloPagina}" Margin="0,0,0,20"/>

                <!-- Filtro -->
                <Border Background="White" CornerRadius="16" Padding="20" Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect Color="#64748B" BlurRadius="20" ShadowDepth="5" Opacity="0.1"/>
                    </Border.Effect>
                    <ComboBox ItemsSource="{Binding Empresas}" SelectedItem="{Binding EmpresaSeleccionada}" DisplayMemberPath="RazonSocial" 
                              materialDesign:HintAssist.Hint="Filtrar por Empresa" Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                </Border>

                <Border Style="{StaticResource EstiloCardContenido}" Padding="0">
                    <DataGrid ItemsSource="{Binding Obligaciones}" SelectedItem="{Binding ObligacionSeleccionada}" 
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                              Background="Transparent" BorderThickness="0" MaxHeight="600"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Padding" Value="15,10"/>
                                <Setter Property="Background" Value="White"/>
                            </Style>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
                                <Setter Property="Padding" Value="15,10"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="CÓDIGO" Binding="{Binding Obligacion.Codigo}" Width="80" FontWeight="Bold" Foreground="#64748B"/>
                            <DataGridTextColumn Header="DESCRIPCIÓN" Binding="{Binding Obligacion.Descripcion}" Width="*" Foreground="#0F172A"/>
                            <DataGridTextColumn Header="VENCE" Binding="{Binding FechaLimite, StringFormat=d}" Width="100" />
                            <DataGridTemplateColumn Header="ESTADO" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding Estado, Converter={StaticResource EstadoToColorConverter}}" CornerRadius="6" Padding="10,4" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Estado}" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </StackPanel>

            <!-- COLUMNA DERECHA: DETALLE -->
            <Grid Grid.Column="1">
                <!-- Mensaje Vacío -->
                <Border Style="{StaticResource EstiloCardContenido}" VerticalAlignment="Center" 
                        Visibility="{Binding ObligacionSeleccionada, Converter={StaticResource NullToCollapsedConverter}}">
                    <StackPanel HorizontalAlignment="Center" Margin="40">
                        <materialDesign:PackIcon Kind="Gavel" Style="{StaticResource PackIconLarge}" Foreground="#CBD5E1" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                        <TextBlock Text="Seleccione una obligación" FontSize="20" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                        <TextBlock Text="Para gestionar su cumplimiento" FontSize="14" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Formulario -->
                <Border Style="{StaticResource EstiloCardContenido}" Visibility="{Binding ObligacionSeleccionada, Converter={StaticResource NullToVisibilityConverter}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Gestión de Cumplimiento" FontSize="24" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding ObligacionSeleccionada.Obligacion.Codigo}" FontSize="14" FontWeight="Bold" Foreground="#10B981" Margin="0,0,0,20"/>

                            <TextBlock Text="Descripción Normativa" Style="{StaticResource MaterialDesignSubtitle2TextBlock}" Foreground="#64748B" Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding ObligacionSeleccionada.Obligacion.Descripcion}" TextWrapping="Wrap" Foreground="#0F172A" Margin="0,0,0,20"/>

                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Artículo" Style="{StaticResource MaterialDesignCaptionTextBlock}" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding ObligacionSeleccionada.Obligacion.Articulo.Numero}" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Fecha Límite" Style="{StaticResource MaterialDesignCaptionTextBlock}" Foreground="#64748B"/>
                                    <DatePicker SelectedDate="{Binding ObligacionSeleccionada.FechaLimite}" materialDesign:HintAssist.Hint="" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Evidencia / Observaciones" Style="{StaticResource MaterialDesignSubtitle2TextBlock}" Foreground="#64748B" Margin="0,10,0,10"/>
                            <TextBox Text="{Binding ObligacionSeleccionada.Observaciones}" 
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                                     TextWrapping="Wrap" Height="120" VerticalScrollBarVisibility="Auto" Margin="0,0,0,20" 
                                     AcceptsReturn="True"/>

                            <Button Command="{Binding GuardarObservacionCommand}" Content="GUARDAR CAMBIOS" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,0,30" />

                            <TextBlock Text="Cambiar Estado" Style="{StaticResource MaterialDesignSubtitle2TextBlock}" Foreground="#64748B" Margin="0,0,0,15"/>
                            
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Command="{Binding MarcarEnProgresoCommand}" Content="EN PROGRESO" 
                                        Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,5,0" />
                                <Button Grid.Column="1" Command="{Binding MarcarCumplidaCommand}" Content="CUMPLIDA" 
                                        Background="#10B981" BorderBrush="#10B981" Foreground="White" FontWeight="Bold"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
