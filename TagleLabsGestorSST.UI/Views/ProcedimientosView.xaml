<UserControl x:Class="TagleLabsGestorSST.UI.Views.ProcedimientosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200">
    <Grid Background="#F1F5F9">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER GRADIENTE -->
        <Border Style="{StaticResource EstiloHeaderHero}" Grid.RowSpan="2"/>

        <!-- CONTENIDO -->
        <Grid Grid.Row="1" Margin="30,-80,30,30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- COLUMNA IZQUIERDA: FORMULARIO -->
            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                <TextBlock Text="Procedimientos de Trabajo (PTS)" Style="{StaticResource EstiloTituloPagina}" Margin="0,0,0,5"/>
                <TextBlock Text="Genera procedimientos de trabajo seguro con asistencia de IA" Style="{StaticResource EstiloSubtituloPagina}" Margin="0,0,0,20"/>

                <Border Style="{StaticResource EstiloCardContenido}">
                    <StackPanel>
                        <!-- Empresa -->
                        <TextBlock Text="Empresa" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,8"/>
                        <ComboBox ItemsSource="{Binding Empresas}" 
                                  SelectedItem="{Binding EmpresaSeleccionada}" 
                                  DisplayMemberPath="RazonSocial" 
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}" 
                                  Margin="0,0,0,16"/>

                        <!-- Descripción de la tarea -->
                        <TextBlock Text="Descripción de la tarea o proceso" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,8"/>
                        <TextBox Text="{Binding DescripcionTarea, UpdateSourceTrigger=PropertyChanged}" 
                                 AcceptsReturn="True" 
                                 Height="100" 
                                 TextWrapping="Wrap" 
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                                 materialDesign:HintAssist.Hint="Ej: Trabajos en altura, Soldadura, Manejo de químicos..."
                                 Margin="0,0,0,16"/>

                        <!-- Responsable y Aprobador -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Responsable" FontSize="12" Foreground="#64748B" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding Responsable}" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Aprobador" FontSize="12" Foreground="#64748B" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding Aprobador}" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Botones de acción -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,20">
                            <Button Command="{Binding GenerarConIACommand}" 
                                    IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}"
                                    Background="#6D28D9" Foreground="White" 
                                    Padding="20,12" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Robot" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="GENERAR CON IA" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding GuardarProcedimientoCommand}" 
                                    Style="{StaticResource MaterialDesignOutlinedButton}" 
                                    Padding="20,12" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ContentSave" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="GUARDAR" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding LimpiarFormularioCommand}" 
                                    Style="{StaticResource MaterialDesignFlatButton}">
                                Limpiar
                            </Button>
                        </StackPanel>

                        <!-- Estado del proceso -->
                        <TextBlock Text="{Binding EstadoProceso}" Foreground="#3B82F6" FontWeight="SemiBold" 
                                   Visibility="{Binding EstadoProceso, Converter={StaticResource NullToCollapsedConverter}}"/>
                                   
                        <!-- Loading indicator -->
                        <ProgressBar IsIndeterminate="True" 
                                     Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                                     Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- COLUMNA DERECHA: PREVIEW -->
            <StackPanel Grid.Column="1" Margin="20,0,0,0">
                <TextBlock Text="Vista Previa del Procedimiento" Style="{StaticResource EstiloTituloPagina}" Margin="0,0,0,5"/>
                <TextBlock Text="Revise y edite el contenido antes de guardar" Style="{StaticResource EstiloSubtituloPagina}" Margin="0,0,0,20"/>

                <Border Style="{StaticResource EstiloCardContenido}">
                    <TextBox Text="{Binding ContenidoProcedimiento, UpdateSourceTrigger=PropertyChanged}" 
                             AcceptsReturn="True" 
                             TextWrapping="Wrap" 
                             VerticalScrollBarVisibility="Auto"
                             Height="500"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="El procedimiento generado aparecerá aquí..."/>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Loading Overlay -->
        <Grid Grid.RowSpan="2" Background="#80000000" 
              Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" 
                             IsIndeterminate="True" 
                             Width="60" Height="60"/>
                <TextBlock Text="{Binding EstadoProceso}" Foreground="White" FontSize="16" 
                           HorizontalAlignment="Center" Margin="0,20,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
