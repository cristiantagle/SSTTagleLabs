<Window x:Class="TagleLabsGestorSST.UI.Views.MatrizRiesgosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:views="clr-namespace:TagleLabsGestorSST.UI.Views"
        Title="MIPER - Matriz de Identificación de Peligros y Evaluación de Riesgos"
        Height="800" Width="1400"
        MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource BrushFondo}"
        FontFamily="{StaticResource FontTexto}">
    
    <Window.Effect>
        <DropShadowEffect Color="#0F172A" BlurRadius="50" ShadowDepth="0" Opacity="0.3"/>
    </Window.Effect>
    
    <Grid>
        <!-- Header con gradiente -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Premium Header -->
        <Border Grid.Row="0" Style="{StaticResource GlassCardDark}" CornerRadius="0" Padding="20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Icon + Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#10B981" CornerRadius="10" Padding="12" Margin="0,0,15,0">
                        <materialDesign:PackIcon Kind="AlertOctagon" Width="28" Height="28" Foreground="White"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="MIPER - Matriz de Riesgos" FontSize="22" FontWeight="Bold" Foreground="White" FontFamily="{StaticResource FontTitulos}"/>
                        <TextBlock Text="Vista Expandida - Más espacio para trabajar" FontSize="12" Foreground="#94A3B8"/>
                    </StackPanel>
                </StackPanel>
                
                <!-- Close Button -->
                <Button Grid.Column="2" Click="CloseButton_Click"
                        Style="{StaticResource MaterialDesignFlatMidBgButton}"
                        Background="#EF4444" Foreground="White" Padding="15,8"
                        materialDesign:ButtonAssist.CornerRadius="8">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Close" Width="18" Height="18" VerticalAlignment="Center"/>
                        <TextBlock Text="CERRAR" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
        
        <!-- Content - MIPER View -->
        <ContentControl Grid.Row="1" Content="{Binding}" Margin="0"/>
    </Grid>
</Window>
