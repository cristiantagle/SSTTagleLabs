<UserControl x:Class="TagleLabsGestorSST.UI.Views.ActualizacionDocumentosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200">
    <Grid Background="#F1F5F9">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER GRADIENTE -->
        <Border Style="{StaticResource EstiloHeaderHero}" Grid.RowSpan="2"/>

        <!-- CONTENIDO -->
        <Grid Grid.Row="1" Margin="30,-80,30,30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- COLUMNA IZQUIERDA: INPUT -->
            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                <TextBlock Text="Actualización Documental IA" Style="{StaticResource EstiloTituloPagina}" Margin="0,0,0,5"/>
                <TextBlock Text="Análisis inteligente de brechas normativas" Style="{StaticResource EstiloSubtituloPagina}" Margin="0,0,0,20"/>

                <Border Style="{StaticResource EstiloCardContenido}">
                    <StackPanel>


                        <Grid Margin="0,0,0,15">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Estado del Servicio -->
                            <StackPanel Orientation="Horizontal" Grid.Row="0">
                                <materialDesign:PackIcon Kind="Robot" Foreground="#3B82F6" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding EstadoServicio}" FontWeight="Bold"
                                           Foreground="#10B981" VerticalAlignment="Center"/>
                            </StackPanel>
                            
                            <!-- Botones de carga -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Column="1" Grid.Row="0">
                                <Button Command="{Binding CargarArchivoCommand}" Content="SUBIR ARCHIVO" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,10,0"/>
                                <Button Command="{Binding CargarEjemploCommand}" Content="Ejemplo" Style="{StaticResource MaterialDesignFlatButton}"/>
                            </StackPanel>
                            
                            <!-- Selector de Modelo IA (nueva fila) -->
                            <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#F0F9FF" CornerRadius="8" Padding="12,8" Margin="0,10,0,0"
                                    Visibility="{Binding ServicioDisponible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Brain" Foreground="#8B5CF6" VerticalAlignment="Center" Margin="0,0,10,0" Width="20" Height="20"/>
                                    <TextBlock Text="Modelo IA:" FontWeight="SemiBold" Foreground="#1E40AF" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <ComboBox ItemsSource="{Binding ModelosDisponibles}" 
                                              SelectedItem="{Binding SelectedModelo}"
                                              Style="{StaticResource MaterialDesignFilledComboBox}"
                                              Width="250" Height="40" FontSize="13" FontWeight="SemiBold"
                                              Foreground="#1E3A5F" Background="White"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <TextBlock Text="Pegue el contenido del documento o reglamento:" Style="{StaticResource MaterialDesignSubtitle2TextBlock}" Foreground="#64748B" Margin="0,0,0,10"/>
                        
                        <TextBox Text="{Binding TextoDocumento}" 
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                 Height="300" TextWrapping="Wrap"
                                 materialDesign:HintAssist.Hint="Contenido del documento a analizar..."
                                 Background="#F1F5F9" BorderBrush="#E2E8F0"/>

                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Command="{Binding AnalizarDocumentoCommand}" Content="ANALIZAR" Height="50"
                                    Background="#0F172A" BorderBrush="#0F172A" Foreground="White" FontSize="14" FontWeight="Bold"
                                    materialDesign:ButtonAssist.CornerRadius="8">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAnalizando}" Value="True">
                                                <Setter Property="IsEnabled" Value="False"/>
                                                <Setter Property="Content" Value="..."/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                                <Button Grid.Column="2" Command="{Binding MejorarRedaccionCommand}" Content="MEJORAR TEXTO" Height="50"
                                    Background="#10B981" BorderBrush="#10B981" Foreground="White" FontSize="14" FontWeight="Bold"
                                    materialDesign:ButtonAssist.CornerRadius="8">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAnalizando}" Value="True">
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Grid.Column="4" Command="{Binding GenerarProcedimientoCommand}" Content="GENERAR PROCEDIMIENTO (IA)" Height="50"
                                    Background="#8B5CF6" BorderBrush="#8B5CF6" Foreground="White" FontSize="14" FontWeight="Bold"
                                    materialDesign:ButtonAssist.CornerRadius="8">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAnalizando}" Value="True">
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- COLUMNA DERECHA: RESULTADO -->
            <Grid Grid.Column="1">
                <Border Style="{StaticResource EstiloCardContenido}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="160"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <Border Background="#F0FDF4" CornerRadius="8" Padding="8">
                                <materialDesign:PackIcon Kind="AutoFix" Foreground="#10B981" Style="{StaticResource PackIconMedium}"/>
                            </Border>
                            <TextBlock Text="Resultados del Análisis" FontSize="18" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" Margin="0,0,0,10">
                            <TextBlock Text="{Binding ResultadoAnalisis}" TextWrapping="Wrap" FontSize="14" Foreground="#0F172A" LineHeight="24"/>
                        </ScrollViewer>

                        <!-- Progreso en Vivo -->
                        <Border Grid.Row="2" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10">
                            <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <materialDesign:PackIcon Kind="Timeline" Style="{StaticResource PackIconMedium}" Foreground="#3B82F6"/>
                                <TextBlock Text="Progreso de IA" FontWeight="Bold" Foreground="#0F172A" Margin="8,0,0,0"/>
                            </StackPanel>
                                <TextBlock Text="{Binding TrazaIa}" Foreground="#0F172A" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding EtaTexto}" FontWeight="SemiBold" Foreground="#2563EB" Margin="0,0,0,6"/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Progreso}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Foreground="#475569" FontSize="12" Margin="0,2,0,2"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <!-- FOOTER ACCIONES -->
                        <StackPanel Grid.Row="3" Margin="0,10,0,0">
                            <TextBlock Text="Opciones de Guardado:" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,5"/>
                            
                            <ComboBox ItemsSource="{Binding Empresas}" SelectedItem="{Binding SelectedEmpresa}"
                                      DisplayMemberPath="RazonSocial"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      materialDesign:HintAssist.Hint="Seleccionar Empresa para Vincular"
                                      Margin="0,0,0,10"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Command="{Binding GuardarWordCommand}" 
                                        Content="EXPORTAR WORD" 
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        BorderBrush="#3B82F6" Foreground="#3B82F6"/>

                                <Button Grid.Column="2" Command="{Binding MigrarReglamentoCommand}" 
                                        Content="MIGRAR A PLANTILLA 2025" 
                                        ToolTip="Extrae datos del documento cargado e inyecta en la plantilla maestra"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Background="#8B5CF6" Foreground="White"/>
                            </Grid>
                        </StackPanel>

                        <!-- Loading Overlay -->
                        <Grid Grid.RowSpan="4" Background="#80FFFFFF" Visibility="{Binding IsAnalizando, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" Value="0" IsIndeterminate="True" Width="50" Height="50" Foreground="#3B82F6"/>
                                <TextBlock Text="{Binding EstadoAnalisis}" Foreground="#3B82F6" FontWeight="Bold" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                                <Button Command="{Binding CancelarOperacionCommand}" 
                                        Content="⛔ CANCELAR" 
                                        Margin="0,15,0,0"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        BorderBrush="#EF4444" Foreground="#EF4444"
                                        Visibility="{Binding PuedeCancel, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
