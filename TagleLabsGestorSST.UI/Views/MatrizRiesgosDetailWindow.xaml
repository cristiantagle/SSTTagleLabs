<Window x:Class="TagleLabsGestorSST.UI.Views.MatrizRiesgosDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:entities="clr-namespace:TagleLabsGestorSST.Data.Entities;assembly=TagleLabsGestorSST.Data"
        mc:Ignorable="d"
        Title="Detalle Riesgo" Height="640" Width="900" WindowStartupLocation="CenterOwner">

    <Grid Background="#F1F5F9" Margin="16">
        <Border Style="{StaticResource EstiloCardContenido}" Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Evaluación de Riesgo (Detalle)" FontSize="20" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                        <Button Name="BtnClose" Width="36" Height="36" Click="BtnClose_Click" Style="{StaticResource MaterialDesignIconButton}">
                            <materialDesign:PackIcon Kind="Close" Style="{StaticResource PackIconSmall}"/>
                        </Button>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="Tarea / Actividad" FontWeight="Bold" Foreground="#64748B"/>
                                        <ComboBox ItemsSource="{Binding ParentViewModel.Tareas, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding Tarea, Mode=TwoWay}" DisplayMemberPath="Nombre" IsEditable="True" Margin="0,6,0,12"/>

                            <TextBlock Text="Peligro" FontWeight="Bold" Foreground="#64748B"/>
                            <ComboBox ItemsSource="{Binding ParentViewModel.Peligros, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding Peligro, Mode=TwoWay}" DisplayMemberPath="Descripcion" IsEditable="True" Margin="0,6,0,12"/>

                            <TextBlock Text="Medida control específica" FontWeight="Bold" Foreground="#64748B"/>
                            <TextBox Text="{Binding MedidaControlEspecifica, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" Margin="0,6,0,12"/>

                            <TextBlock Text="Observaciones" FontWeight="Bold" Foreground="#64748B"/>
                            <TextBox Text="{Binding Observaciones, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" Margin="0,6,0,12" Height="80"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Evaluación" FontWeight="Bold" Foreground="#64748B"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,12">
                                <TextBlock Text="Probabilidad:" FontWeight="SemiBold" Width="110"/>
                                <TextBox Text="{Binding Probabilidad, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="Consecuencia:" FontWeight="SemiBold" Width="110"/>
                                <TextBox Text="{Binding Consecuencia, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="Nivel riesgo:" FontWeight="SemiBold" Width="110"/>
                                <TextBox Text="{Binding NivelRiesgo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120" FontWeight="Bold"/>
                            </StackPanel>

                            <TextBlock Text="Tipo de control" FontWeight="Bold" Foreground="#64748B"/>
                            <ComboBox ItemsSource="{Binding ParentViewModel.Controles, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding Control, Mode=TwoWay}" DisplayMemberPath="Descripcion" Margin="0,6,0,12"/>
                        </StackPanel>
                    </Grid>
                    
                    <!-- Save / Close -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Click="BtnSave_Click" Style="{StaticResource MaterialDesignRaisedButton}" Background="#10B981" Foreground="White" Width="120" Height="40">Guardar</Button>
                        <Button Click="BtnClose_Click" Style="{StaticResource MaterialDesignFlatButton}" Margin="8,0,0,0" Width="120" Height="40">Cancelar</Button>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
