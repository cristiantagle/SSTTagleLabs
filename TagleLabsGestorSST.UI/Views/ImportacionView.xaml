<UserControl x:Class="TagleLabsGestorSST.UI.Views.ImportacionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200">
    <Grid Background="#F1F5F9">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER GRADIENTE -->
        <Border Style="{StaticResource EstiloHeaderHero}" Grid.RowSpan="2"/>

        <!-- CONTENIDO -->
        <Grid Grid.Row="1" Margin="30,-80,30,30">
            <StackPanel HorizontalAlignment="Center" Width="900">
                <TextBlock Text="Importación Masiva" Style="{StaticResource EstiloTituloPagina}" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                <TextBlock Text="Carga de datos desde Excel" Style="{StaticResource EstiloSubtituloPagina}" Margin="0,0,0,30" HorizontalAlignment="Center"/>

                <!-- TAB CONTROL con tabs visibles -->
                <Border Background="White" CornerRadius="12" Padding="0">
                    <TabControl Background="Transparent" Padding="0">
                        <TabControl.Resources>
                            <Style TargetType="TabItem" BasedOn="{StaticResource MaterialDesignTabItem}">
                                <Setter Property="Padding" Value="20,12"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="14"/>
                            </Style>
                        </TabControl.Resources>
                    
                        <!-- TAB 1: TRABAJADORES -->
                        <TabItem>
                            <TabItem.Header>
                                <Border Background="#EFF6FF" CornerRadius="8" Padding="15,10" Margin="5">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="AccountGroup" Width="22" Height="22" Foreground="#3B82F6" Margin="0,0,10,0"/>
                                        <TextBlock Text="TRABAJADORES" FontWeight="Bold" Foreground="#1E40AF" FontSize="13"/>
                                    </StackPanel>
                                </Border>
                            </TabItem.Header>
                        <Border Style="{StaticResource EstiloCardContenido}" Margin="0,15,0,0">
                            <StackPanel>
                                <TextBlock Text="Importar Trabajadores desde Excel" FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,20"/>
                                
                                <TextBlock Text="1. Configuración de Destino" Style="{StaticResource MaterialDesignSubtitle2TextBlock}" Foreground="#64748B" Margin="0,0,0,15"/>
                                <Grid Margin="0,0,0,25">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox ItemsSource="{Binding Empresas}" SelectedItem="{Binding EmpresaSeleccionada}" DisplayMemberPath="RazonSocial" 
                                              materialDesign:HintAssist.Hint="Empresa Destino" Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                                    <ComboBox Grid.Column="2" ItemsSource="{Binding CentrosTrabajo}" SelectedItem="{Binding CentroTrabajoSeleccionado}" DisplayMemberPath="Nombre" 
                                              materialDesign:HintAssist.Hint="Centro de Trabajo" Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                                </Grid>

                                <TextBlock Text="2. Archivo de Datos" Style="{StaticResource MaterialDesignSubtitle2TextBlock}" Foreground="#64748B" Margin="0,0,0,15"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding RutaArchivo}" materialDesign:HintAssist.Hint="Seleccione archivo .xlsx" IsReadOnly="True" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,10,0" />
                                    <Button Grid.Column="1" Content="EXAMINAR" Click="BtnExaminar_Click" Style="{StaticResource MaterialDesignOutlinedButton}" Height="50" />
                                </Grid>
                                
                                <Border Background="#F1F5F9" CornerRadius="8" Padding="15" Margin="0,0,0,20">
                                    <TextBlock Text="📋 Columnas: RUT | Nombre | Cargo | Fecha Ingreso | Email | Direccion | Comuna | Estado Civil | Fecha Nac | AFP | Salud | Foto" 
                                               FontSize="11" Foreground="#64748B" TextWrapping="Wrap"/>
                                </Border>

                                <Button Command="{Binding ImportarTrabajadoresCommand}" Content="IMPORTAR TRABAJADORES" Height="50" 
                                        Background="#0F172A" BorderBrush="#0F172A" Foreground="White" FontSize="14" FontWeight="Bold"
                                        materialDesign:ButtonAssist.CornerRadius="8"/>

                                <Expander Header="Ver Log de Resultados" Margin="0,20,0,0" IsExpanded="True">
                                    <Border Background="#0F172A" CornerRadius="8" Padding="15" Margin="0,10,0,0" Height="150">
                                        <ScrollViewer>
                                            <TextBlock Text="{Binding ResultadoTexto}" FontFamily="Consolas" Foreground="#10B981" TextWrapping="Wrap" />
                                        </ScrollViewer>
                                    </Border>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </TabItem>

                    <!-- TAB 2: EMPRESAS -->
                        <TabItem>
                            <TabItem.Header>
                                <Border Background="#F0FDF4" CornerRadius="8" Padding="15,10" Margin="5">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Domain" Width="22" Height="22" Foreground="#16A34A" Margin="0,0,10,0"/>
                                        <TextBlock Text="EMPRESAS" FontWeight="Bold" Foreground="#166534" FontSize="13"/>
                                    </StackPanel>
                                </Border>
                            </TabItem.Header>
                        <Border Style="{StaticResource EstiloCardContenido}" Margin="0,15,0,0">
                            <StackPanel>
                                <TextBlock Text="Importar Empresas desde Excel" FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,20"/>
                                
                                <TextBlock Text="Archivo de Datos" Style="{StaticResource MaterialDesignSubtitle2TextBlock}" Foreground="#64748B" Margin="0,0,0,15"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding RutaArchivoEmpresas}" materialDesign:HintAssist.Hint="Seleccione archivo .xlsx" IsReadOnly="True" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,10,0" />
                                    <Button Grid.Column="1" Content="EXAMINAR" Click="BtnExaminarEmpresas_Click" Style="{StaticResource MaterialDesignOutlinedButton}" Height="50" />
                                </Grid>
                                
                                <Border Background="#EFF6FF" CornerRadius="8" Padding="15" Margin="0,0,0,20">
                                    <StackPanel>
                                        <TextBlock Text="📋 Columnas del Excel:" FontWeight="Bold" Foreground="#1E40AF" Margin="0,0,0,8"/>
                                        <TextBlock Text="A: RUT Empresa | B: Razón Social | C: Giro | D: Nº Trabajadores" FontSize="12" Foreground="#3B82F6"/>
                                        <TextBlock Text="E: Dirección | F: Teléfono | G: Email | H: Rep. Legal | I: Mutual" FontSize="12" Foreground="#3B82F6"/>
                                    </StackPanel>
                                </Border>

                                <Button Command="{Binding ImportarEmpresasCommand}" Content="IMPORTAR EMPRESAS" Height="50" 
                                        Background="#10B981" BorderBrush="#10B981" Foreground="White" FontSize="14" FontWeight="Bold"
                                        materialDesign:ButtonAssist.CornerRadius="8"/>

                                <Expander Header="Ver Log de Resultados" Margin="0,20,0,0" IsExpanded="True">
                                    <Border Background="#0F172A" CornerRadius="8" Padding="15" Margin="0,10,0,0" Height="150">
                                        <ScrollViewer>
                                            <TextBlock Text="{Binding ResultadoEmpresasTexto}" FontFamily="Consolas" Foreground="#10B981" TextWrapping="Wrap" />
                                        </ScrollViewer>
                                    </Border>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </TabItem>
                    </TabControl>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Loading Overlay -->
        <Grid Grid.RowSpan="2" Background="#90000000" Visibility="{Binding EstaProcesando, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" Value="0" IsIndeterminate="True" Width="60" Height="60" Foreground="White" Margin="0,0,0,20"/>
                <TextBlock Text="Procesando datos..." Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
