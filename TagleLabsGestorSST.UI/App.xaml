<Application x:Class="TagleLabsGestorSST.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TagleLabsGestorSST.UI.ViewModels"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:views="clr-namespace:TagleLabsGestorSST.UI.Views"
             xmlns:converters="clr-namespace:TagleLabsGestorSST.UI.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Material Design v5 Theme Bundle -->
                <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="BlueGrey" SecondaryColor="Teal" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- PALETA DE COLORES DEEP TECH (Slate, Emerald & Indigo) -->
            <Color x:Key="PrimarioAzulOscuro">#0F172A</Color> <!-- Slate 900 -->
            <Color x:Key="SecundarioVerde">#10B981</Color>    <!-- Emerald 500 -->
            <Color x:Key="AcentoIndigo">#6366F1</Color>       <!-- Indigo 500 -->
            <Color x:Key="FondoClaro">#F8FAFC</Color>         <!-- Slate 50 -->
            <Color x:Key="BlancoGlass">#CCFFFFFF</Color>      <!-- White with Opacity -->
            <Color x:Key="RojoAlerta">#EF4444</Color>         <!-- Red 500 -->
            <Color x:Key="AmarilloAlerta">#F59E0B</Color>     <!-- Amber 500 -->
            
            <SolidColorBrush x:Key="BrushPrimario" Color="{StaticResource PrimarioAzulOscuro}" />
            <SolidColorBrush x:Key="BrushSecundario" Color="{StaticResource SecundarioVerde}" />
            <SolidColorBrush x:Key="BrushAcento" Color="{StaticResource AcentoIndigo}" />
            <!-- Fondo con gradiente suave para evitar planitud -->
            <LinearGradientBrush x:Key="BrushFondo" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#EEF2F7" Offset="0"/>
                <GradientStop Color="#F8FAFC" Offset="1"/>
            </LinearGradientBrush>
            <SolidColorBrush x:Key="BrushAlerta" Color="{StaticResource RojoAlerta}" />
            <SolidColorBrush x:Key="BrushWarning" Color="{StaticResource AmarilloAlerta}" />
            <SolidColorBrush x:Key="BrushGlass" Color="{StaticResource BlancoGlass}" />
            
            <!-- Dynamic Theme Brushes (updated by ThemeService) -->
            <SolidColorBrush x:Key="BrushCardBackground" Color="White" />
            <SolidColorBrush x:Key="BrushTextPrimary" Color="#0F172A" />
            <SolidColorBrush x:Key="BrushTextSecondary" Color="#64748B" />
            <SolidColorBrush x:Key="BrushBorder" Color="#E2E8F0" />

            <!-- Nuevo converter para AsistenciaPro -->
            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>

            <!-- Standardized PackIcon styles -->
            <Style x:Key="PackIconSmall" TargetType="{x:Type materialDesign:PackIcon}">
                <Setter Property="Width" Value="18" />
                <Setter Property="Height" Value="18" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,8,0" />
            </Style>

            <Style x:Key="PackIconMedium" TargetType="{x:Type materialDesign:PackIcon}">
                <Setter Property="Width" Value="24" />
                <Setter Property="Height" Value="24" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="PackIconLarge" TargetType="{x:Type materialDesign:PackIcon}">
                <Setter Property="Width" Value="60" />
                <Setter Property="Height" Value="60" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="PackIconXLarge" TargetType="{x:Type materialDesign:PackIcon}">
                <Setter Property="Width" Value="80" />
                <Setter Property="Height" Value="80" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="PackIconAvatar" TargetType="{x:Type materialDesign:PackIcon}">
                <Setter Property="Width" Value="35" />
                <Setter Property="Height" Value="35" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            
            <FontFamily x:Key="FontTitulos">Outfit, Segoe UI Semibold</FontFamily>
            <FontFamily x:Key="FontTexto">Inter, Segoe UI</FontFamily>

            <!-- LOGO: TAGLE HEX -->
            <Geometry x:Key="LogoHexagono">M 25,0 L 46.65,12.5 L 46.65,37.5 L 25,50 L 3.35,37.5 L 3.35,12.5 Z M 25,10 L 25,40 M 10,20 L 40,20</Geometry>

            <!-- ============================================ -->
            <!-- 🎨 PREMIUM UI STYLES - GLASSMORPHISM & ANIMATIONS -->
            <!-- ============================================ -->
            
            <!-- GLASSMORPHISM CARD STYLE -->
            <Style x:Key="GlassCard" TargetType="Border">
                <Setter Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#F8FFFFFF" Offset="0"/>
                            <GradientStop Color="#E8FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
                <Setter Property="CornerRadius" Value="16"/>
                <Setter Property="Padding" Value="24"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#40FFFFFF" Offset="0"/>
                            <GradientStop Color="#20E2E8F0" Offset="1"/>
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="#1E293B" BlurRadius="30" ShadowDepth="8" Opacity="0.08" Direction="270"/>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- GLASSMORPHISM DARK CARD (for headers) -->
            <Style x:Key="GlassCardDark" TargetType="Border">
                <Setter Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#F00F172A" Offset="0"/>
                            <GradientStop Color="#E01E293B" Offset="1"/>
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
                <Setter Property="CornerRadius" Value="16"/>
                <Setter Property="Padding" Value="24"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="#30FFFFFF"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="10" Opacity="0.3" Direction="270"/>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- PREMIUM BUTTON WITH GLOW -->
            <Style x:Key="BotonPremium" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                <Setter Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#10B981" Offset="0"/>
                            <GradientStop Color="#059669" Offset="1"/>
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Padding" Value="20,12"/>
                <Setter Property="FontFamily" Value="{StaticResource FontTitulos}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="12"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="#10B981" BlurRadius="20" ShadowDepth="4" Opacity="0.4"/>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Effect">
                            <Setter.Value>
                                <DropShadowEffect Color="#10B981" BlurRadius="30" ShadowDepth="0" Opacity="0.6"/>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- ANIMATED FADE-IN STYLE FOR USER CONTROLS -->
            <Style x:Key="FadeInView" TargetType="UserControl">
                <Setter Property="Opacity" Value="0"/>
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <TranslateTransform Y="20"/>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                                                 From="0" To="1" Duration="0:0:0.4" 
                                                 EasingFunction="{StaticResource MaterialDesignEasingFunction}"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" 
                                                 From="20" To="0" Duration="0:0:0.4"
                                                 EasingFunction="{StaticResource MaterialDesignEasingFunction}"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Style.Triggers>
            </Style>

            <!-- HOVER LIFT EFFECT FOR CARDS -->
            <Style x:Key="HoverLiftCard" TargetType="Border">
                <Setter Property="Background" Value="White"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Padding" Value="20"/>
                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <TranslateTransform Y="0"/>
                    </Setter.Value>
                </Setter>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="#64748B" BlurRadius="10" ShadowDepth="2" Opacity="0.08"/>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Effect">
                            <Setter.Value>
                                <DropShadowEffect Color="#6366F1" BlurRadius="25" ShadowDepth="8" Opacity="0.15"/>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="BorderBrush" Value="#A5B4FC"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- ESTILO BOTÓN SIDEBAR -->
            <Style x:Key="EstiloBotonMenu" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                <Setter Property="Foreground" Value="#94A3B8"/> <!-- Slate 400 -->
                <Setter Property="Height" Value="50"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Padding" Value="20,0"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="8" Margin="10,2">
                                <Grid>
                                    <Border x:Name="Glow" Background="{StaticResource BrushAcento}" Opacity="0" CornerRadius="8" Effect="{x:Null}"/>
                                    <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="#1E293B"/> <!-- Slate 800 -->
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                                <!-- Efecto de "Activo" o Hover fuerte -->
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Glow" Property="Opacity" Value="0.1"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ESTILO BOTÓN PRIMARIO GLOBAL -->
            <Style x:Key="BotonPrimario" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                <Setter Property="Background" Value="{StaticResource BrushSecundario}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Padding" Value="14,8"/>
                <Setter Property="FontFamily" Value="{StaticResource FontTitulos}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="10"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="#0F172A" BlurRadius="12" ShadowDepth="2" Opacity="0.15"/>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#14C38A"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="#0EA66F"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.6"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- ESTILO BOTÓN OUTLINE SECUNDARIO -->
            <Style x:Key="BotonSecundario" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                <Setter Property="Foreground" Value="{StaticResource BrushAcento}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BrushAcento}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Padding" Value="14,8"/>
                <Setter Property="FontFamily" Value="{StaticResource FontTitulos}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="10"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#EEF2FF"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.6"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- ESTILO INPUT TEXTO (uses Material Design theme colors) -->
            <Style x:Key="EntradaTexto" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
                <Setter Property="CaretBrush" Value="{StaticResource BrushAcento}"/>
                <Setter Property="materialDesign:TextFieldAssist.UnderlineBrush" Value="{StaticResource BrushAcento}"/>
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="FontFamily" Value="{StaticResource FontTexto}"/>
            </Style>

            <!-- ESTILO COMBO (uses Material Design theme colors) -->
            <Style x:Key="EntradaCombo" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="FontFamily" Value="{StaticResource FontTexto}"/>
            </Style>

            <!-- ESTILOS POR DEFECTO (let Material Design handle themes) -->
            <Style TargetType="Button" BasedOn="{StaticResource BotonPrimario}" />
            <!-- Remove automatic dark overrides, let views use MaterialDesignOutlinedTextBox -->
            <!-- <Style TargetType="TextBox" BasedOn="{StaticResource EntradaTexto}" /> -->
            <!-- <Style TargetType="ComboBox" BasedOn="{StaticResource EntradaCombo}" /> -->

            <!-- ESTILOS GLOBALES TAILWIND -->
            <Style x:Key="EstiloCardContenido" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource BrushCardBackground}"/>
                <Setter Property="CornerRadius" Value="18"/>
                <Setter Property="Padding" Value="28"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="#0F172A" BlurRadius="25" ShadowDepth="4" Opacity="0.08"/>
                    </Setter.Value>
                </Setter>
                <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>

            <Style x:Key="EstiloTituloPagina" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontFamily" Value="{StaticResource FontTitulos}"/>
                <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
            </Style>

            <Style x:Key="EstiloSubtituloPagina" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="#94A3B8"/> <!-- Slate 400 -->
                <Setter Property="Margin" Value="0,5,0,0"/>
            </Style>

            <!-- HERO HEADER STYLE -->
            <Style x:Key="EstiloHeaderHero" TargetType="Border">
                <Setter Property="Height" Value="180"/>
                <Setter Property="VerticalAlignment" Value="Top"/>
                <Setter Property="Panel.ZIndex" Value="0"/>
                <Setter Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0F172A" Offset="0.0"/>
                            <GradientStop Color="#1E293B" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate DataType="{x:Type vm:LoginViewModel}">
                <views:LoginView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:EmpresasViewModel}">
                <views:EmpresasView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:TrabajadoresViewModel}">
                <views:TrabajadoresView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:MatrizRiesgosViewModel}">
                <views:MatrizRiesgosView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ObligacionesViewModel}">
                <views:ObligacionesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SiniestrosViewModel}">
                <views:SiniestrosView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DocumentosViewModel}">
                <views:DocumentosView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ProcedimientosViewModel}">
                <views:ProcedimientosView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ImportacionViewModel}">
                <views:ImportacionView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AuditoriaViewModel}">
                <views:AuditoriaView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ActualizacionDocumentosViewModel}">
                <views:ActualizacionDocumentosView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:BusquedaSemanticaViewModel}">
                <views:BusquedaSemanticaView />
            </DataTemplate>
            
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <converters:InvertedBooleanToVisibilityConverter x:Key="InvertedBooleanToVisibilityConverter" />
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <converters:NullToCollapsedConverter x:Key="NullToCollapsedConverter" />
            <converters:EstadoToColorConverter x:Key="EstadoToColorConverter" />
            <converters:BooleanToColorConverter x:Key="BooleanToColorConverter" />
            <converters:NameInitialConverter x:Key="NameInitialConverter" />
            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
            <converters:NivelRiesgoToColorConverter x:Key="NivelRiesgoToColorConverter" />

            <!-- ESTILO CARD TRABAJADOR (LISTA) -->
            <Style x:Key="EstiloCardTrabajador" TargetType="ListBoxItem">
                <Setter Property="Background" Value="White"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="12" Padding="15" BorderThickness="1" BorderBrush="Transparent">
                                <Border.Effect>
                                    <DropShadowEffect Color="#64748B" BlurRadius="10" ShadowDepth="2" Opacity="0.05"/>
                                </Border.Effect>
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="#F8FAFC"/>
                                    <Setter TargetName="Border" Property="BorderBrush" Value="#E2E8F0"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="#F0FDF4"/> <!-- Emerald 50 -->
                                    <Setter TargetName="Border" Property="BorderBrush" Value="#10B981"/>
                                    <Setter TargetName="Border" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="#10B981" BlurRadius="15" ShadowDepth="0" Opacity="0.2"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
